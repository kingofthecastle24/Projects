<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Package visibility (Android 11+): without this, resolving the intent that opens
        Health Connect's permission-request screen can silently fail to find a target on
        some devices/OS versions, even though Health Connect itself is installed and
        otherwise detected as available.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!--
        Read-only Health Connect permissions. There are no WRITE_* permissions
        declared anywhere in this app - Milestone 1 is a read-only diagnostic proof.
    -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_STEPS_CADENCE" />

    <application
        android:name=".HealthProofApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthProof">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HealthProof">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Required so Health Connect can deep-link back into this app after the
                user grants/denies permissions, and so the app appears in Health
                Connect's "Manage data > App permissions" list with a rationale.
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
            Handles the privacy-policy / rationale intent Health Connect (and the
            Play Store data-safety flow) sends when the user taps "why is this
            data needed" for this app, on Android versions where Health Connect
            is a system module (Android 14+).
        -->
        <activity-alias
            android:name=".PermissionsRationaleActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
